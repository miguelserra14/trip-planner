.env
.venv/
__pycache__/
.ipynb_checkpoints/
# Reports are the traveller's own trips, the kept ones in reports/saved/ too: none belongs in a public repository
/reports/
# The state of the Claude Code sessions that worked on the project
.claude/
# The answers of the timetables, kept a day for the next searches (sources/timetables/client.py)
/cache/
# Crash dumps of command-line tools
*.stackdump
# Languages added by a model are made again with one click (More languages, in the app), so only the two
# written by hand belong in the repository
/trip_planner/texts/languages/*.py
!/trip_planner/texts/languages/en.py
!/trip_planner/texts/languages/pt-PT.py
# A cache being written whole (utils.write_whole), left behind if its process was stopped at that moment
*.writing
