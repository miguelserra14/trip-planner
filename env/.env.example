# Copy this file to .env and fill in the keys. Only the first one is required. The .env file stays on your computer: it is in .gitignore.

# Google AI Studio, free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Tavily web search, free tier: https://app.tavily.com
# Without it the program uses the timetables and the operators' prices on their own.
TAVILY_API_KEY=

# Optional, plan B for the models: Mistral, free tier: https://console.mistral.ai
# With it, a model of Mistral answers whenever the Gemini models fail or run out of quota.
# MISTRAL_API_KEY=

# Optional: ask Gemini and Mistral through a Cloudflare AI Gateway (free: dashboard > AI > AI Gateway > Create),
# for a log and the numbers of every call. The address is https://gateway.ai.cloudflare.com/v1/<account id>/<gateway name>
# AI_GATEWAY_URL=
# Only when the gateway is set to authenticated: its token
# AI_GATEWAY_TOKEN=

# Optional: a few friends reach the app on this computer through a Cloudflare Tunnel, behind Cloudflare Access
# (Zero Trust > Access > Applications, a login by email). All four or none. README, "Security and privacy".
# The public hostname the tunnel serves, and the port its service points to (http://127.0.0.1:<port>)
# REMOTE_HOST=trips.example.com
# REMOTE_PORT=8765
# The Zero Trust team name (<team>.cloudflareaccess.com) and the Access application's audience tag (its Overview page)
# ACCESS_TEAM=
# ACCESS_AUD=

# Optional: traces of every run in LangSmith
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
