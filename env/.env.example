# Copy this file to .env and fill in the two keys. The .env file stays on your computer: it is in .gitignore.

# Google AI Studio, free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Tavily web search, free tier: https://app.tavily.com
TAVILY_API_KEY=

# Optional: traces of every run in LangSmith
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
