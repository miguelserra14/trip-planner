.env
.venv/
__pycache__/
.ipynb_checkpoints/
# The recent reports come and go. Only the ones kept on purpose, in reports/saved/, belong in the repository
/reports/*
!/reports/saved/
# Crash dumps of command-line tools
*.stackdump
# Languages added by a model are made again with one click (Languages... in the window), so only the two
# written by hand belong in the repository
/trip_planner/texts/languages/*.py
!/trip_planner/texts/languages/en.py
!/trip_planner/texts/languages/pt-PT.py
